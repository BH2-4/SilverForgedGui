# Silver Forged Gui — Global Demand Engine V1
# Copy this file to .env.local and fill in real values as needed.

# --- Demo Mode ---
# When true, the app runs entirely without an AI provider using a heuristic
# response. The UI clearly labels responses as "DEMO MODE · Sample response".
# Automatically enabled when no ANTHROPIC_API_KEY is set.
DEMO_MODE=true

# --- Anthropic ---
# Provide a key to use real Claude. Server-side only; never exposed to the client.
ANTHROPIC_API_KEY=

# Model identifier for the Anthropic provider. Kept as an env var so it can be
# swapped without a code change. Default aligns with Claude Opus 4.7.
AI_MODEL=claude-opus-4-7

# --- Tunables ---
AI_MAX_TOKENS=2400
AI_TIMEOUT_MS=45000

# --- Stage 6 · Dynamic Visual Layer ---
# Set to "false" to disable the global particle background (kill switch for
# debugging / performance testing). Any other value (or unset) leaves the
# layer enabled. prefers-reduced-motion is honored independently.
NEXT_PUBLIC_PARTICLE_EFFECT=true

# --- Stage 5 · Image Render ---
# IMAGE_PROVIDER=mock              Deterministic SVG placeholder (default, no API key).
# IMAGE_PROVIDER=openai-dalle3     Real DALL·E 3 text-to-image. Requires OPENAI_API_KEY.
# IMAGE_PROVIDER=openai-gpt-image  RECOMMENDED — gpt-image-1 grounded on REAL Miao silver
#                                  photos from public/collection/assets/images (reference-
#                                  based generation: the render inherits the documented
#                                  material, craft and form language). Requires OPENAI_API_KEY.
IMAGE_PROVIDER=openai-gpt-image
OPENAI_API_KEY=
# Optional — relay/proxy base URL (e.g. https://your-relay.example.com/v1).
# Leave empty to hit the official api.openai.com. The relay's token group
# MUST include an image model (gpt-image-1), not only text models.
OPENAI_BASE_URL=
# --- 成品独立站（Collection Shop）---
# 双路线中的"直接选购"线：顶栏「成品系列」与首页「直接选购成品」按钮
# 跳转的目标地址。填你们银饰独立站平台的正式域名（含 https://）。
# 未设置时按钮指向 "#" 占位，不发生真实跳转。
NEXT_PUBLIC_COLLECTION_URL=